@page "/salachat"
@using ChatBlazorSignalR.Chats

<div class="container mt-4">
	<div class="card shadow-sm">
		<div class="card-body">
			<div class="mb-3">
				<label class="form-label">Ingresa tu usuario:</label>
				<div class="input-group">
					<input type="text" class="form-control" @bind="MyUser" />
					<button class="btn btn-warning">Desconectar</button>
				</div>
			</div>
		</div>




		@if (Messages is not null)
		{
			if (Messages.Count> 0)
			{

				@foreach (var chat in Messages)
				{
					<div class="chat-container  @chat.Direction" >
						<div class="chat-bubble @chat.Direction">
							<div class="fw-bold">@chat.User	</div>
							@chat.Message
						</div>
					</div>
				}
			}
		}
		<div class="mt-3">
			<label class="form-label">Mensaje:</label>
			<textarea class="form-control mb-2" rows="3" placeholder="Ingresa el mensaje"></textarea>
		</div>
		<div class="d-flex justify-content-end"> 
			<button class="btn btn-primary" tabindex="SendMessage">Enviar</button>
		</div>
	</div>
</div>


@code {
	private string MyUser { get; set; }
	private List<Chat> Messages { get; set; } = new List<Chat>();

	protected override async Task OnInitializedAsync()
	{
		// // Simulate loading messages from a service
		// await Task.Delay(1000);
		Messages = new List<Chat>
		{
			new Chat { User = "User1", Message = "Hello!", IsMe=true },
			new Chat { User = "User2", Message = "Hi there!", IsMe=false }
		};
		await base.OnInitializedAsync();
		return;
	}
}
